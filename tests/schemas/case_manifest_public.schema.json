{
  "title": "One row of manifests/case_manifest_public.csv",
  "description": "DRAFT 2026-11-25, proposed by Lane 6 from what the code on main writes today. Not frozen: the team freezes it at the Week 1 checkpoint. Every value is text, as read from the CSV. No label column is allowed.",
  "type": "object",
  "required": [
    "case_id",
    "CWE",
    "source_path",
    "line_range",
    "project_group_id",
    "java_version",
    "scan_status",
    "file_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^CASE_[0-9]{2}$"
    },
    "CWE": {
      "type": "string",
      "enum": [
        "CWE-22",
        "CWE-89"
      ]
    },
    "source_path": {
      "type": "string",
      "pattern": "^cases/CASE_[0-9]{2}\\.java$"
    },
    "line_range": {
      "type": "string",
      "pattern": "^[0-9]+-[0-9]+$"
    },
    "project_group_id": {
      "type": "string",
      "pattern": "^GRP_[0-9]{2}$"
    },
    "java_version": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "scan_status": {
      "type": "string",
      "minLength": 1
    },
    "file_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
